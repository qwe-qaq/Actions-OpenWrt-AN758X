#=========================================================================
# 13. 光器件驱动（BOSA）—— 两颗互斥，本机型已按硬件选定
#=========================================================================
# UX3363 分页式 BOSA（上行 xPON）★内置
CONFIG_PACKAGE_kmod-airoha-paged-bosa=y
# CONFIG_PACKAGE_kmod-airoha-en7572 is not set     # EN7572，本机型不用

#=========================================================================
# 14. 硬件卸载 —— NPU / PPE，PON 与以太网共用 ★每机型必开
#     wifi7-an4475 的 DTS &npu firmware-name 指向 airoha/en7581_MT7996_npu_*.bin，
#     必须装 airoha-en7581-mt7996-npu-firmware（w1700k / nokia_valyrian 同款约定）。
#     不带 MT7996 的包提供的是 en7581_npu_*.bin，名字对不上 →
#     request_firmware -ENOENT → -EPROBE_DEFER，NPU 一直不绑定。
#     ⚠ 源码 target.mk 的 DEFAULT_PACKAGES 里还有 airoha-en7581-npu-firmware，
#       会被 select 强制选中，写 is not set 也挡不住；多出的两个文件无害。
#=========================================================================
# CONFIG_PACKAGE_airoha-en7581-npu-firmware is not set
# en7581_MT7996_npu_rv32.bin / _data.bin
CONFIG_PACKAGE_airoha-en7581-mt7996-npu-firmware=y
# CONFIG_PACKAGE_airoha-an7583-npu-firmware is not set
# 卸载链路的另外三个包（kmod-nft-offload / kmod-nf-flow / kmod-nf-conntrack-bridge）
# 已在第 4 段「网络转发 / nftables」里启用，此处不重复写

#=========================================================================
# 15. WiFi 7 —— MediaTek vendor full-MAC 驱动（MT7993 + MT799B）
#
#     qwe-qaq/ponwrt@wifi7-an4475 的 DTS 删除了 mediatek,mt76 PCIe 子节点，
#     vendor 驱动按 PCI 14c3:7993 / 14c3:799b 绑定。两条路线互斥：
#       · mt76 / mac80211 版 → configs/fiberhome_an4475-g2.config（master 分支）
#       · vendor full-MAC 版 → 本文件（wifi7-an4475 分支）
#     装了 mt76 包但 DTS 没有对应子节点，驱动不会 probe；若子节点还在则
#     会与 vendor 驱动抢同一个 endpoint。所以这里全部显式关闭。
#
#     下面这些 CONFIG_PACKAGE_* 与源码树 image/an7581.mk 里
#     Device/fiberhome_an4475-g2 的 DEVICE_PACKAGES 一一对应。
#     Validate configuration 会拿 tmp/.targetinfo 的 Target-Profile-Packages
#     逐项核对，缺一条就直接 error（apk 组装阶段不过滤缺包）。
#=========================================================================
# cfg80211 配置 API（vendor 驱动的 CFG80211_SUPPORT 依赖）
CONFIG_PACKAGE_kmod-cfg80211=y
# WPA 认证（hostapd + wpa_supplicant）
CONFIG_PACKAGE_wpad-openssl=y
# hostapd 公共文件 / 热插拔脚本
CONFIG_PACKAGE_hostapd-common=y
# 无线国家码与频段数据库
CONFIG_PACKAGE_wireless-regdb=y
# 无线命令行工具
CONFIG_PACKAGE_iw=y
# 25.12 起 iwinfo 只是空壳：CONFIG_WIFI_SCRIPTS_UCODE=y 时它的 install 段
# 就是 ":"，/usr/bin/iwinfo 由 wifi-scripts 的 files-ucode/usr/bin/iwinfo 提供。
# 更要紧的是 iwinfo-ucode 的 DEPENDS 带 @!PACKAGE_iwinfo —— 这里一开，
# defconfig 就把 iwinfo-ucode 整个丢掉，而 mtwifi-cfg-ucode 的 "+iwinfo-ucode"
# 照样写进 apk 的 depend，最后 package/install 报：
#   iwinfo-ucode (no such package): required by mtwifi-cfg-ucode-4-r1
# ponwrt 自带的 configs/an7581.config / an7583.config 同样是 not set。
# CONFIG_PACKAGE_iwinfo is not set

# --- vendor Wi-Fi 7 包：与 DEVICE_PACKAGES 对账用，必须全部 =y ---
# mt_wifi.ko（full-MAC AP 驱动主体）
CONFIG_PACKAGE_kmod-mt_wifi7=y
# mt_wifi_osal.ko（含 6.18 netif_rx_ni 兼容补丁）
CONFIG_PACKAGE_kmod-mt_wifi_osal=y
# mtk_hwifi.ko
CONFIG_PACKAGE_kmod-mt_hwifi=y
# mtk_pci.ko
CONFIG_PACKAGE_kmod-mtk_pci=y
# connac_if.ko
CONFIG_PACKAGE_kmod-connac_if=y
# mt7993.ko（option_type=1 rro_mode=5 intr_option_set=4）
CONFIG_PACKAGE_kmod-mt7993=y
# mt799b.ko（原厂 mt7993 分支末尾无条件加载）
CONFIG_PACKAGE_kmod-mt799b=y
# 生成 /etc/wireless/l1profile.dat + 安装 mt7993 profiles
CONFIG_PACKAGE_wifi-profile=y
# wifi-profile 的 WIFI_SCRIPT_SUPPORT（l1profile.config.in，默认 y）会安装
# /sbin/wifi（files/common/wifi_jedi）和 /lib/wifi/*.lua，那是 lua 版
# wifi_jedi + mtwifi-cfg 的组合；本配置走的是 mtwifi-cfg-ucode 路线，
# /sbin/wifi 必须由 wifi-scripts 提供，否则 apk 在装配时直接报：
#   ERROR: wifi-profile-1: trying to overwrite sbin/wifi owned by
#          wifi-scripts-1.0-r4
# 关掉它只影响这两个脚本，/etc/wireless/**/*.dat 与 l1profile.dat 照常安装。
# CONFIG_WIFI_SCRIPT_SUPPORT is not set
# vendor 无线配置 ucode 脚本
# --- mtwifi-cfg-ucode 依赖闭包：Kconfig 的 select 链带 depends，必须显式 =y ---
# 参考 immortalwrt-mt798x-rebase/defconfig/low-mem-512m/mt7987-mt7993-be3600.config
# 以及 package/custom/mtwifi-cfg-ucode/Makefile 的 UCODE_DEPENDS 全量清单：
#   +ucode +ucode-mod-fs +ucode-mod-log +ucode-mod-ubus +ucode-mod-uci
#   +ucode-mod-datconf +ucode-mod-l1parser +wifi-scripts +iwinfo-ucode +mwctl
# 漏掉运行时依赖会让 defconfig 把本包降级，见下方 CONFLICTS 说明。
CONFIG_PACKAGE_ucode=y
CONFIG_PACKAGE_ucode-mod-fs=y
CONFIG_PACKAGE_ucode-mod-log=y
CONFIG_PACKAGE_ucode-mod-ubus=y
CONFIG_PACKAGE_ucode-mod-uci=y
CONFIG_PACKAGE_libkvcutil=y
CONFIG_PACKAGE_kvcedit=y
CONFIG_PACKAGE_datconf=y
CONFIG_PACKAGE_ucode-mod-datconf=y
CONFIG_PACKAGE_libl1parser=y
CONFIG_PACKAGE_l1util=y
CONFIG_PACKAGE_ucode-mod-l1parser=y
CONFIG_PACKAGE_iwinfo-ucode=y
CONFIG_PACKAGE_wifi-scripts=y
# 全局开关（package/network/config/wifi-scripts/Config.in，默认 y）。
# 显式写死：/usr/bin/iwinfo 的提供者就是它，关掉会连命令行都没有。
CONFIG_WIFI_SCRIPTS_UCODE=y
CONFIG_PACKAGE_mtwifi-cfg-ucode=y
# package-metadata.pl 的 CONFLICTS:=mtwifi-cfg 会生成
# "depends on m || (PACKAGE_mtwifi-cfg != y)"；若 feeds 里 lua 版 mtwifi-cfg
# 被默认选中，ucode 版就会被 kbuild 强制降为 n，显式关掉它。
# CONFIG_PACKAGE_mtwifi-cfg is not set
# vendor 无线调试/控制工具
CONFIG_PACKAGE_mwctl=y

# --- mt76 / mac80211 路线关闭（与 vendor full-MAC 互斥）---
# CONFIG_PACKAGE_kmod-mt76-core is not set
# CONFIG_PACKAGE_kmod-mt76-connac is not set
# CONFIG_PACKAGE_kmod-mt7996e is not set
# CONFIG_PACKAGE_kmod-mt7990-firmware is not set
# CONFIG_PACKAGE_kmod-mac80211 is not set
# 注：CONFIG_PACKAGE_MAC80211_DEBUGFS / MAC80211_MESH 是 kmod-mac80211 的
#     子符号，关闭主包后会被 defconfig 剔除，无害；保留在补充段仅为历史兼容。

#=========================================================================
# 15b. MTK SDK Kconfig —— 缺一个，芯片模块 / 固件 / l1profile.dat 就不生成
#
#   package/custom 是 Kconfig 驱动的，只把包写进 DEVICE_PACKAGES 不够：
#     · KernelPackage/mt7993|mt799b 的 DEPENDS 带 @MTK_HWIFI_MT7993 / @MTK_HWIFI_MT799B
#       （config.in 里两者无 default y）→ 不启用就选不中包
#     · mt_hwifi/Makefile 的 MT7993 固件安装被 ifeq(CONFIG_MTK_HWIFI_MT7993,y) 包裹
#     · mt_wifi7/Makefile 的 EEPROM 安装被 ifeq(CONFIG_MTK_WIFI7_CHIP_MT7993,y) 包裹
#     · mt_wifi7 的 DEPENDS 带 +@DRIVER_11AC/AX/BE_SUPPORT（hostapd Config.in 默认 n）
#   不要启用 FAST_NAT_SUPPORT / WHNAT_SUPPORT / CONNINFRA_APSOC / WED_SUPPORT：
#   它们会引入本树不存在的 kmod-mediatek_hnat / kmod-conninfra / kmod-warp。
#=========================================================================
CONFIG_DRIVER_11AC_SUPPORT=y
CONFIG_DRIVER_11AX_SUPPORT=y
CONFIG_DRIVER_11BE_SUPPORT=y
CONFIG_MTK_HWIFI_PCI_SUPPORT=y
CONFIG_MTK_HWIFI_CONNAC_IF_SUPPORT=y
CONFIG_MTK_HWIFI_MT7993=y
CONFIG_MTK_HWIFI_MT799B=y
# 对齐原厂 EN7581 加载参数
CONFIG_MTK_HWIFI_MT7993_RRO_MODE=5
CONFIG_MTK_HWIFI_MT7993_OPTION_TYPE=1
CONFIG_MTK_HWIFI_MT7993_INTR_OPTION_SET=4
CONFIG_MTK_WIFI7_FIRST_IF_MT7993=y
CONFIG_MTK_WIFI7_SECOND_IF_MT7993=y
CONFIG_MTK_WIFI7_THIRD_IF_NONE=y
CONFIG_MTK_WIFI7_CHIP_MT7993=y
CONFIG_MTK_WIFI7_OSAL_SUPPORT=y
# MTK_WIFI7_MT_WIFI 是 config.in 里唯一的 AP/STA 功能总开关：tristate、
# 无 default、也没有任何 select 指向它，只能显式 =y。它关闭时
# "if MTK_WIFI7_MT_WIFI" 覆盖的整段（Main Mode choice、MT_AP_SUPPORT、
# CFG80211、WDS/MBSS/APCLI/MUMIMO 等 49 个 default y 项）全部不可见，
# CFG80211_SUPPORT 因 depends 不满足被 defconfig 降级 → 驱动能编但没有 AP。
CONFIG_MTK_WIFI7_MT_WIFI=y
CONFIG_MTK_WIFI7_MODE_AP=y
CONFIG_MTK_WIFI7_MT_AP_SUPPORT=y
CONFIG_MTK_WIFI7_CFG80211_SUPPORT=y
# CFG80211=y 会让 KernelPackage/mt_wifi7 的 "+MTK_WIFI7_CFG80211_SUPPORT:
# kmod-cfg80211" 变成硬依赖，缺它整包被禁。该包已在 510 行显式 =y。
# KernelPackage/cfg80211 的 DEPENDS 是
#   +iw +!WIFI_SCRIPTS_UCODE:iwinfo +wifi-scripts +wireless-regdb
# 即 iwinfo 只在 WIFI_SCRIPTS_UCODE 关掉时才被拉进来；本配置显式 =y，
# 所以关掉 CONFIG_PACKAGE_iwinfo 不会反过来被 cfg80211 拉回。
# 与已关闭的 kmod-mac80211 同属 package/kernel/mac80211，但各自独立打包。
CONFIG_MTK_WIFI7_SKU_TYPE="BE3600"

# MAP / 802.11k / 802.11r 不是可选特性，而是这批厂商代码的隐含前提：
# cmm_profile.c、cfg80211_ap.c、cmm_rdm_mt.c、rt_channel.c、fsm_sync.c 在
# 没有任何 #ifdef 的情况下直接调用 IS_MAP_* / wapp_send_* / scan_extra_probe_req，
# 并访问 wifi_dev.MAPCfg、wifi_dev.cac_required、RTMP_ADAPTER.bh_bss_wdev，
# 而 map.h 只在 CONFIG_MAP_SUPPORT 下被 rtmp.h 引入；cfg80211_tx.c 的
# 802.11k 邻区上报用到的 IE_RRM_* / RRM_BSSID_INFO / BSS_ENTRY.RegulatoryClass
# 来自 dot11k_rrm.h，cfg80211_rx.c 用的 wifi_dev.FtCfg 来自 dot11r_ft。
# 关掉这些开关时上一轮（#356）在 8 个文件里报了 84 条错，且都不是调用点能加
# 守卫解决的 —— 厂商代码根本不以「关掉 MAP」为受支持配置。
# MAP_SUPPORT 会 select INTERWORKING / WNM / DOT11K_RRM / DOT11R_FT /
# DOT11W_PMF，并在 config_ap.mk 里同时带出 -DWAPP_SUPPORT，正好覆盖全部报错点。
CONFIG_MTK_WIFI7_MAP_SUPPORT=y
CONFIG_MTK_WIFI7_DOT11K_RRM_SUPPORT=y
CONFIG_MTK_WIFI7_DOT11R_FT_SUPPORT=y

#=========================================================================
# 15c. L1 profile —— make-l1profile.py 只认 .config 里显式出现的 first_card_* 行
#
#   缺失时 validate() 在空 dict 上通过，genfile() 只写出 "Default" 空文件，
#   驱动拿不到任何 card 信息。l1profile.config.in 的 second/third_card 默认 y
#   （MT7615），必须显式关掉，否则会多出 INDEX1 / INDEX2。
#   EEPROM_size=0x14a800 与原厂 factory 卷校准 blob（1353728 B）及 DTS
#   vendor_eeprom@40000 完全一致。
#   EEPROM_name 用 "e2p"：wifi_e2p.init 在 /lib/firmware/$FIRMWARE 已存在时直接
#   return，若沿用原厂 MT7993_EEPROM.bin 会命中包内自带 7680 B 默认 blob，
#   跳过从 Factory 分区提取设备专属校准数据。
#=========================================================================
CONFIG_first_card=y
CONFIG_first_card_name="MT7993"
CONFIG_first_card_profile_path="/etc/wireless/mediatek/mt7993.1.dat"
CONFIG_first_card_init_script="/lib/wifi/mtwifi.lua"
CONFIG_first_card_init_compatible="mtwifi"
CONFIG_first_card_EEPROM_offset="0x0"
CONFIG_first_card_EEPROM_size="0x14a800"
CONFIG_first_card_EEPROM_name="e2p"
CONFIG_first_card_EEPROM_def_bin_path="/lib/firmware/MT7993_EEPROM.bin"
CONFIG_first_card_main_ifname="ra0;rai0"
CONFIG_first_card_ext_ifname="ra;rai"
CONFIG_first_card_wds_ifname="wds;wdsi"
CONFIG_first_card_apcli_ifname="apcli;apclii"
CONFIG_first_card_mesh_ifname="mesh;meshi"
CONFIG_first_card_nvram_zone="dev00;dev01"
CONFIG_first_card_single_sku_path="/rom/etc/wireless/mediatek/mt7993-sku.dat"
CONFIG_first_card_bf_sku_path="/rom/etc/wireless/mediatek/mt7993-sku-bf.dat"
# CONFIG_second_card is not set
# CONFIG_third_card is not set

#=========================================================================
# 16. USB 与存储 —— USB2.0（usb1，u3p-dis-msk=<0x1>），保留通用存储栈
#=========================================================================
CONFIG_PACKAGE_kmod-usb-core=y
# xHCI 主机控制器
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
# Airoha/MediaTek 平台 xHCI
CONFIG_PACKAGE_kmod-usb-xhci-mtk=y
# USB3 核心（3.0 口未引出）
CONFIG_PACKAGE_kmod-usb3=y
# USB 存储
CONFIG_PACKAGE_kmod-usb-storage=y
# UAS 协议
CONFIG_PACKAGE_kmod-usb-storage-uas=y
# USB 口 LED 触发
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=y
# USB 硬盘依赖
CONFIG_PACKAGE_kmod-scsi-core=y
# 挂载点管理
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_exfat-mkfs=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y

#=========================================================================
# 17. 2.5G PHY —— combo 电口 PHY ID 待实机确认，两套驱动都带上
#=========================================================================
CONFIG_PACKAGE_kmod-phy-realtek=y                 
# 裕太微 YT8821 / YT8531（2.5G 位二选一 BOM 的另一半）
CONFIG_PACKAGE_kmod-phy-motorcomm=y
# CONFIG_PACKAGE_kmod-phy-airoha-en8811h=y          # 备选：EN8811H 2.5G PHY
# CONFIG_PACKAGE_airoha-en8811h-firmware=y          # 备选：EN8811H MD32 固件
# CONFIG_PACKAGE_kmod-phy-maxlinear is not set    # GPY211，本机型不用
# CONFIG_PACKAGE_rtl826x-firmware is not set      # RTL826x 10G 固件，本机型不用

#=========================================================================
# 17b. LED —— 电源灯 GPIO35 + PON 灯 PWM ch10 / pad gpio18
#=========================================================================
#CONFIG_PACKAGE_kmod-leds-pwm=y                    # pwm-leds（pon:green）
#CONFIG_PACKAGE_kmod-pwm-airoha=y                  # AN7581 PWM 控制器
# 9555 扩展器（SYS / VPN / INTERNET 三颗灯）
CONFIG_PACKAGE_kmod-gpio-pca953x=y
CONFIG_PACKAGE_kmod-i2c-gpio=y
CONFIG_PACKAGE_kmod-i2c-algo-bit=y 

#=========================================================================
# 18. 引导与固件 —— TF-A BL2 / BL31（AN7581）
#=========================================================================
# CONFIG_PACKAGE_trusted-firmware-a-an7581-bl2=y   → 本树没有这个包名（TF-A 走 trusted-firmware-a 的 bl2/bl31 变体），
#   defconfig 会静默剔除。本板 IMAGES 只有 sysupgrade.itb，不含 bootloader，无影响。
# CONFIG_PACKAGE_trusted-firmware-a-an7581-bl31=y   → 本树没有这个包名（TF-A 走 trusted-firmware-a 的 bl2/bl31 变体），
#   defconfig 会静默剔除。本板 IMAGES 只有 sysupgrade.itb，不含 bootloader，无影响。

#=========================================================================
# 19. 可选插件 —— 由 diy-part3.sh 拉取，默认全部关闭
#      取消注释即可编进固件；插件越多编译越久、镜像越大
#=========================================================================
# --- 科学上网 / 代理 ---
# CONFIG_PACKAGE_luci-app-passwall=y
# CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y
# CONFIG_PACKAGE_luci-app-passwall2=y
# CONFIG_PACKAGE_luci-app-openclash=y
# CONFIG_PACKAGE_luci-app-nikki=y
# CONFIG_PACKAGE_luci-app-momo=y
#
# ⚠ luci-app-daed 依赖内核 BTF，启用时还必须打开：
#     CONFIG_KERNEL_DEBUG_INFO_BTF=y
#     CONFIG_KERNEL_MODULE_ALLOW_BTF_MISMATCH=y
#     CONFIG_KERNEL_BPF=y  CONFIG_KERNEL_BPF_SYSCALL=y  CONFIG_KERNEL_BPF_EVENTS=y
# 否则 eBPF 程序加载不了（基座只有 DEBUG_INFO，未开 BTF）
# CONFIG_PACKAGE_luci-app-daed=y
#
# --- 功能插件 ---
# CONFIG_PACKAGE_luci-app-upnp=y                  # UPnP
# CONFIG_PACKAGE_luci-app-poweroffdevice=y        # 关机
# CONFIG_PACKAGE_luci-app-owq-wol=y               # 网络唤醒
# CONFIG_PACKAGE_luci-app-lucky=y                 # lucky：DDNS + socat
# CONFIG_PACKAGE_luci-app-openlist2=y             # alist/openlist 挂载
# CONFIG_PACKAGE_luci-app-watchdog=y              # 看门狗
# CONFIG_PACKAGE_luci-app-taskplan=y              # 定时任务
# CONFIG_PACKAGE_luci-app-oaf=y                   # 应用过滤 OAF
# CONFIG_PACKAGE_luci-app-accesscontrol=y         # 上网控制
#
# --- DNS ---
# CONFIG_PACKAGE_luci-app-mosdns=y
# CONFIG_PACKAGE_luci-app-smartdns=y
#
# --- VPN ---
# CONFIG_PACKAGE_luci-app-easytier=y
# CONFIG_PACKAGE_luci-app-tailscale=y
#
# --- 主题 ---
# argon 主题设置页
CONFIG_PACKAGE_luci-app-argon-config=n
# CONFIG_PACKAGE_luci-theme-kucat=y
# CONFIG_PACKAGE_luci-app-kucat-config=y

#=========================================================================
# 20. 其他常用（按需取消注释）
#=========================================================================
# CONFIG_PACKAGE_curl=y
# CONFIG_PACKAGE_nano=y
# CONFIG_PACKAGE_htop=y
# CONFIG_PACKAGE_ttyd=y
# CONFIG_PACKAGE_zram-swap=y
# CONFIG_PACKAGE_kmod-zram=y
# CONFIG_PACKAGE_cfdisk=y
# CONFIG_PACKAGE_gdisk=y
# CONFIG_PACKAGE_sgdisk=y
# CONFIG_PACKAGE_kmod-mmc=m
# CONFIG_PACKAGE_mmc-utils=y
# CONFIG_PACKAGE_pciutils=y
# CONFIG_PACKAGE_kmod-nvme=m
#=========================================================================
# 独立模式补充段 —— 取消「源码基座 configs/<soc>.config 打底」后必须显式写
#
# 判定依据：源码树 configs/an7581.config 头部为
#   "Automatically generated file; DO NOT EDIT."，是 make defconfig 产物。
#   其中 =y 的符号分两类：
#     · Kconfig default 为 y           -> defconfig 自动重建，无需写
#     · Kconfig default 非 y / 无 default -> 不写就丢，必须写（下面 33 项）
#   另有 2 项基座显式 is not set 但 default=y，不写会被翻转开启。
#
# 下列「开机必需」项无需也不应写在这里，defconfig 会自动生成：
#   · 核心包 netifd / dropbear / firewall4 / fstools / mtd / nftables /
#     ppp / odhcpd / uboot-envtools / base-files / procd / busybox ...
#     由 DEFAULT_PACKAGES -> CONFIG_DEFAULT_* 驱动
#   · CONFIG_DEFAULT_* / CONFIG_BUSYBOX_DEFAULT_* / CONFIG_MODULE_* 等
#     Kconfig 内部符号
#   · 内核基础能力 MTD_UBI / UBIFS_FS / SPI_NAND / SERIAL / SECCOMP
#     由 target/linux/airoha/an7581/config-6.18 兜底
#=========================================================================
CONFIG_BUSYBOX_CONFIG_DEVMEM=y
CONFIG_KERNEL_BTRFS_FS_POSIX_ACL=y
CONFIG_KERNEL_CGROUP_SCHED=y
CONFIG_KERNEL_CIFS_ACL=y
CONFIG_KERNEL_COREDUMP=y
CONFIG_KERNEL_DEBUG_KERNEL=y
CONFIG_KERNEL_DEVMEM=y
CONFIG_KERNEL_EROFS_FS_POSIX_ACL=y
CONFIG_KERNEL_EROFS_FS_XATTR=y
CONFIG_KERNEL_EXT4_FS_POSIX_ACL=y
CONFIG_KERNEL_F2FS_FS_POSIX_ACL=y
CONFIG_KERNEL_FREEZER=y
CONFIG_KERNEL_FS_POSIX_ACL=y
CONFIG_KERNEL_HFSPLUS_FS_POSIX_ACL=y
CONFIG_KERNEL_HFS_FS_POSIX_ACL=y
CONFIG_KERNEL_IPV6_MROUTE_MULTIPLE_TABLES=y
CONFIG_KERNEL_IPV6_MULTIPLE_TABLES=y
CONFIG_KERNEL_IPV6_PIMSM_V2=y
CONFIG_KERNEL_IPV6_SUBTREES=y
CONFIG_KERNEL_IP_MROUTE_MULTIPLE_TABLES=y
CONFIG_KERNEL_IP_PIMSM_V1=y
CONFIG_KERNEL_IP_PIMSM_V2=y
CONFIG_KERNEL_JFFS2_FS_POSIX_ACL=y
CONFIG_KERNEL_JFS_POSIX_ACL=y
CONFIG_KERNEL_MEMCG_KMEM=y
CONFIG_KERNEL_MPTCP_IPV6=y
CONFIG_KERNEL_NFS_ACL_SUPPORT=y
CONFIG_KERNEL_PAGE_POOL=y
CONFIG_KERNEL_PREEMPT_NONE=y
CONFIG_KERNEL_REISER_FS_POSIX_ACL=y
CONFIG_KERNEL_RELAY=y
CONFIG_KERNEL_TMPFS_POSIX_ACL=y
CONFIG_KERNEL_XFS_POSIX_ACL=y

# 防止被 Kconfig default 翻转开启（保持与源码基座一致）
# CONFIG_BUSYBOX_CONFIG_LOGIN_SESSION_AS_CHILD is not set
# CONFIG_KERNEL_CGROUP_PERF is not set
