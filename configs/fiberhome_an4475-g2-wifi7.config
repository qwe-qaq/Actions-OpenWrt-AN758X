# AN758x PonWrt 单机型精简配置（diffconfig）—— 使用前必须 make defconfig 展开
# profile      : fiberhome_an4475-g2
# 机型         : 烽火 AN4475-G2（FTTR 主光猫 / 10G xPON）
# SoC          : AN7581
# 硬件要点     : XG-PON 上行 + 下行 FTTR 光口，1x2.5G 光电复用 + 4xGE，WiFi 7
# 光器件       : 上行 UX3363（分页式 BOSA @ I2C 0x51）；下行 FSL61167P / UX3326S1
# 网口 PHY     : 2.5G combo 电口（DTS 为 ethernet-phy-id001c.c849，ID 待实机确认）
# 无线         : MT7993 + MT799B，PCI 14c3:7993 / 14c3:799b（WiFi 7 BE3600）
# USB          : USB2.0（usb1，mediatek,u3p-dis-msk=<0x1>）
# 校准/身份数据: factory（AN4-2MiB 容器，UBI 卷必须 2 MiB）
#
# ★ Wi-Fi 7 vendor full-MAC 驱动专用配置（与 mt76 版 fiberhome_an4475-g2.config 互斥）
#   - 源码必须是 qwe-qaq/ponwrt@wifi7-an4475（source=fork / branch=wifi7-an4475）
#     该分支带 package/custom/{mt_wifi7,mt_hwifi,mt_wifi_osal,wifi-profile,mtwifi-cfg-ucode,mwctl}
#     等 vendor 包，且 DTS 删除了 mediatek,mt76 PCIe 子节点，让 vendor 驱动按 PCI ID 绑定。
#   - master 分支没有这些包，用本配置会在 defconfig 阶段被静默剔除；
#     pbs05/ponwrt 也没有该机型 profile。两者都会在 Validate configuration 失败。
#   - 本文件由 build-ponwrt.yml 在 REPO_BRANCH=wifi7-an4475 时自动选用，
#     不需要（也不要）手动改 workflow 的 CONFIG_FILE。
#
# 源码         : qwe-qaq/ponwrt（fork），分支 wifi7-an4475
# 内核         : 6.18    包管理：apk + 全量签名
# 组件来源     : ImmortalWrt feeds（packages / luci）+ pon_drivers / pon_userspace
#               + 源码树自带 package/custom 下的 MediaTek vendor Wi-Fi 7 包
#               网络栈全部走 nftables（firewall4 + kmod-nft-*），不引入 iptables / OpenWrt 官方 feed 包
#
# ⚠ 精简配置只写与基座的差异，必须 make defconfig 展开后才能 make
#=========================================================================
# ⚠ 本文件的 CONFIG_ 行一律不带行尾注释：cat >> .config 后 make defconfig
#   会把 "=y  # 注释" 的 # 之后当作值的一部分，对 int/string 符号直接判非法。

CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_LINUX_6_18=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_UBIFS_FREE_SPACE_FIXUP=y
CONFIG_JSON_OVERVIEW_IMAGE_INFO=y
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_an4475-g2=y
CONFIG_TARGET_DEVICE_PACKAGES_airoha_an7581_DEVICE_fiberhome_an4475-g2=""

#=========================================================================
# apk 包管理（ImmortalWrt 24.10+ 默认，替代 opkg）+ 全量签名
#=========================================================================
CONFIG_USE_APK=y
CONFIG_SIGNED_PACKAGES=y
CONFIG_SIGNATURE_CHECK=y
CONFIG_DOWNLOAD_CHECK_CERTIFICATE=y
CONFIG_SIGN_EACH_PACKAGE=y
CONFIG_SIGN_FIRMWARE=y

#=========================================================================
# 编译与内核选项
#=========================================================================
CONFIG_DEVEL=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_PKG_FORTIFY_SOURCE_1=y
CONFIG_PKG_RELRO_FULL=y
CONFIG_PKG_DT_RELR=y
CONFIG_PKG_CHECK_FORMAT_SECURITY=y
CONFIG_PKG_ASLR_PIE_REGULAR=y
CONFIG_PKG_CC_STACKPROTECTOR_REGULAR=y
CONFIG_KERNEL_CC_STACKPROTECTOR_REGULAR=y
CONFIG_KERNEL_STACKPROTECTOR=y
CONFIG_USE_SSTRIP=y
CONFIG_SSTRIP_DISCARD_TRAILING_ZEROES=y
CONFIG_KERNEL_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_MOLD=y
CONFIG_IPV6=y
CONFIG_KERNEL_IPV6=y
# 说明：CONFIG_CCACHE 默认不写（保持关闭）。
# ccache 由 tools/ccache 安装到 staging_dir/host/bin，而 tools 只在
# CONFIG_CCACHE 生效时才会编入（tools/Makefile: ifneq ($(CONFIG_CCACHE)$(CONFIG_SDK),)）。
# 若工具链缓存是在「未开 ccache」时建立的，缓存命中会跳过 make tools/install，
# 于是 rules.mk 里 TARGET_CC:= ccache $(TARGET_CC) 找不到二进制 →
#   /bin/sh: 1: .../staging_dir/host/bin/ccache: not found  (Error 127)
# 需要 ccache 时请在 workflow 里把 USE_CCACHE 置 true，流程会自动补装并做好兜底。

#=========================================================================
# 1. PON 内核驱动 —— 光口链路核心，缺一个 pon 口就不通
#=========================================================================
# PON MAC：MAC/TC 层，pond 与硬件之间的通道
CONFIG_PACKAGE_kmod-airoha-xpon=y
# 光前端抽象层：BOSA 读写、校准数据、DDM 光功率/温度
CONFIG_PACKAGE_kmod-airoha-pon-frontend=y

#=========================================================================
# 2. PON 用户态 —— 守护进程与工具
#=========================================================================
# OMCI+OAM 协议代理：ONU 注册、LOID 认证、GEM/XGEM 协商
CONFIG_PACKAGE_airoha-pond=y
# 线路配置与状态：光功率、温度、偏置电流、ONU 状态
CONFIG_PACKAGE_airoha-ponctl=y
# 抓包与诊断：OMCI/OAM 报文抓取，日常可关
CONFIG_PACKAGE_airoha-pon-debug=y

#=========================================================================
# 3. PON / IPTV 的 LuCI 界面
#=========================================================================
# PON 界面 + 板级身份编辑：SN/MAC/LOID/Vendor ID
CONFIG_PACKAGE_luci-app-pon=y
# luci-app-pon 中文包
CONFIG_PACKAGE_luci-i18n-pon-zh-cn=y
# IPTV 桥接配置：LAN 口 / VLAN 绑定
CONFIG_PACKAGE_luci-app-iptv=y
# IPv4 组播代理主程序
CONFIG_PACKAGE_igmpproxy=y
# IGMP Proxy Web 配置界面
CONFIG_PACKAGE_luci-app-igmpproxy=y
# luci-app-iptv 中文包
CONFIG_PACKAGE_luci-i18n-iptv-zh-cn=y
# IPTV 组播转单播（RTP -> HTTP）
CONFIG_PACKAGE_luci-app-rtp2httpd=y

#=========================================================================
# 4. 网络转发 / nftables —— 全部走 nft，不引入 iptables
#=========================================================================
# nftables 核心
CONFIG_PACKAGE_kmod-nft-core=y
# NAT
CONFIG_PACKAGE_kmod-nft-nat=y
# 桥接族
CONFIG_PACKAGE_kmod-nft-bridge=y
# FIB 查找，策略路由用
CONFIG_PACKAGE_kmod-nft-fib=y
# socket 匹配，透明代理避免回环
CONFIG_PACKAGE_kmod-nft-socket=y
# TProxy 透明代理
CONFIG_PACKAGE_kmod-nft-tproxy=y
# 全锥形 NAT，游戏/PT 友好
CONFIG_PACKAGE_kmod-nft-fullcone=y
# nf NAT 支撑
CONFIG_PACKAGE_kmod-nf-nat=y
# nf socket 匹配
CONFIG_PACKAGE_kmod-nf-socket=y
# nf TProxy
CONFIG_PACKAGE_kmod-nf-tproxy=y
# 连接跟踪核心
CONFIG_PACKAGE_kmod-nf-conntrack=y
# conntrack netlink 接口
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y
# 桥接连接跟踪，IPTV 桥接 + 卸载需要
CONFIG_PACKAGE_kmod-nf-conntrack-bridge=y
# flow offload 内核支撑
CONFIG_PACKAGE_kmod-nf-flow=y
# nftables flow offload -> PPE 硬件转发
CONFIG_PACKAGE_kmod-nft-offload=y
# 日志
CONFIG_PACKAGE_kmod-nf-log=y
# IPv6 日志
CONFIG_PACKAGE_kmod-nf-log6=y
# REJECT
CONFIG_PACKAGE_kmod-nf-reject=y
# IPv6 REJECT
CONFIG_PACKAGE_kmod-nf-reject6=y
# nfnetlink
CONFIG_PACKAGE_kmod-nfnetlink=y
# socket 诊断
CONFIG_PACKAGE_kmod-inet-diag=y
# netlink 诊断
CONFIG_PACKAGE_kmod-netlink-diag=y

#=========================================================================
# 5. 隧道与拨号
#=========================================================================
# WireGuard VPN
CONFIG_PACKAGE_kmod-wireguard=y
# TUN 虚拟网卡
CONFIG_PACKAGE_kmod-tun=y
# UDP 隧道 IPv4
CONFIG_PACKAGE_kmod-udptunnel4=y
# UDP 隧道 IPv6
CONFIG_PACKAGE_kmod-udptunnel6=y
# macvlan 虚拟网卡
CONFIG_PACKAGE_kmod-macvlan=y
# PPP
CONFIG_PACKAGE_kmod-ppp=y
# PPPoE
CONFIG_PACKAGE_kmod-pppoe=y
# PPP over X
CONFIG_PACKAGE_kmod-pppox=y
# PPP 压缩
CONFIG_PACKAGE_kmod-slhc=y
# MPPE 加密（PPTP）
CONFIG_PACKAGE_kmod-mppe=y
# OpenVPN 兼容层
CONFIG_PACKAGE_kmod-ovpn-backports=y

#=========================================================================
# 6. LuCI 界面（ImmortalWrt 组件）
#=========================================================================
# LuCI 语言总开关（luci.mk: i18n 包 DEFAULT := LUCI_LANG_zh_Hans || (ALL&&m)）
# 该符号是 tristate 且无 default，默认 n，必须显式写 =y。
# 置 y 后，所有已选中且带 po 目录的 luci 包会自动选中 zh-cn 中文包。
# 简体中文（zh-cn）
CONFIG_LUCI_LANG_zh_Hans=y
# CONFIG_LUCI_LANG_zh_Hant is not set              # 繁体中文
# LuCI 元包
CONFIG_PACKAGE_luci=y
# 轻量版
CONFIG_PACKAGE_luci-light=y
# 基础框架
CONFIG_PACKAGE_luci-base=y
# 管理
CONFIG_PACKAGE_luci-mod-admin-full=y
# 网络
CONFIG_PACKAGE_luci-mod-network=y
# 状态
CONFIG_PACKAGE_luci-mod-status=y
# 系统
CONFIG_PACKAGE_luci-mod-system=y
# 防火墙
CONFIG_PACKAGE_luci-app-firewall=y
# 软件包（IM 特有，配合 apk）
CONFIG_PACKAGE_luci-app-package-manager=y
# IPv6 协议
CONFIG_PACKAGE_luci-proto-ipv6=y
# PPP 协议
CONFIG_PACKAGE_luci-proto-ppp=y
# argon 主题
CONFIG_PACKAGE_luci-theme-argon=y
# bootstrap 主题
CONFIG_PACKAGE_luci-theme-bootstrap=y
# nixio（openssl）
CONFIG_PACKAGE_luci-lib-nixio_openssl=y
# uQR 二维码库
CONFIG_PACKAGE_luci-lib-uqr=y
# 基础中文包
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
# 防火墙中文包
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
# 软件包中文包
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

# --- 硬件状态监控（由 diy-part1.sh 拉取 / 拷贝；AN758x 专属）---
# 温度由 autocore 的 /sbin/tempinfo 提供（概览页「温度」行：CPU / WiFi / PON）
# Airoha SoC 状态页：NPU 卸载/CPU 频率/Frame Engine/PPE 流表
CONFIG_PACKAGE_luci-app-airoha-npu=y
# 上者中文包（po 改名由 diy-part1.sh 处理）
CONFIG_PACKAGE_luci-i18n-airoha-npu-zh-cn=y
# PON 光模块卡片：收发光/温度/电流/电压（概览页系统下一格）
CONFIG_PACKAGE_luci-app-pon-status=y
# NAT 类型选择器：全锥形/受限/对称三选一（网络-NAT类型）
CONFIG_PACKAGE_luci-app-natmode=y
# 面板 LED：光信号/光纤/WLAN/USB 按原厂语义（PCA9555 15 颗灯 + 系统-面板 LED 控制页）
CONFIG_PACKAGE_luci-app-ledpanel=y

#=========================================================================
# 7. 基础服务 —— ImmortalWrt 默认栈
#=========================================================================
# DNS/DHCP 全功能版（IM 默认）
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_dnsmasq_full_dnssec=y
CONFIG_PACKAGE_dnsmasq_full_auth=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_dnsmasq_full_conntrack=y
CONFIG_PACKAGE_dnsmasq_full_noid=y
CONFIG_PACKAGE_dnsmasq_full_tftp=y
# nftables 防火墙
CONFIG_PACKAGE_firewall4=y
# nftables JSON 接口
CONFIG_PACKAGE_nftables-json=y
# 网络接口守护
CONFIG_PACKAGE_netifd=y
# IPv6 客户端
CONFIG_PACKAGE_odhcp6c=y
# IPv6 服务端/中继
CONFIG_PACKAGE_odhcpd-ipv6only=y
# PPP
CONFIG_PACKAGE_ppp=y
# PPPoE 拨号
CONFIG_PACKAGE_ppp-mod-pppoe=y
# SSH
CONFIG_PACKAGE_dropbear=y
# Web 服务器
CONFIG_PACKAGE_uhttpd=y
# uhttpd ubus 插件
CONFIG_PACKAGE_uhttpd-mod-ubus=y
# ubus RPC 守护
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-rpcsys=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y
CONFIG_PACKAGE_rpcd-mod-ucode=y
# conntrack 命令行
CONFIG_PACKAGE_conntrack=y
# IM：系统状态信息
CONFIG_PACKAGE_autocore=y
# IM：shell 同步
CONFIG_PACKAGE_shellsync=y
CONFIG_PACKAGE_getrandom=y
CONFIG_PACKAGE_urandom-seed=y
# 随机数守护
CONFIG_PACKAGE_urngd=y
# CA 证书
CONFIG_PACKAGE_ca-bundle=y
# 软件源公钥
CONFIG_PACKAGE_openwrt-keyring=y
# apk 包管理器
CONFIG_PACKAGE_apk-openssl=y

#=========================================================================
# 8. 系统工具
#=========================================================================
# 抓包，配合 pon-debug 排查
CONFIG_PACKAGE_tcpdump=y
# 测速
CONFIG_PACKAGE_iperf3=y
# 网卡查询/设置（2.5G 协商）
CONFIG_PACKAGE_ethtool-full=y
# ip 命令全功能
CONFIG_PACKAGE_ip-full=y
# bridge 命令
CONFIG_PACKAGE_ip-bridge=y
# 光模块 i2c 调试
CONFIG_PACKAGE_i2c-tools=y
# MTD 分区读写
CONFIG_PACKAGE_mtd=y
# NAND 工具
CONFIG_PACKAGE_nand-utils=y
# UBI 工具
CONFIG_PACKAGE_ubi-utils=y
# fitblk：FIT 升级用。释放 uImage.FIT 块设备（/usr/sbin/fitblk +
# /lib/upgrade/fit.sh）。基座里是 =m（只编译不进固件），这里改成 =y 装进
# rootfs。AN758X 出的是 .itb（FIT）镜像，sysupgrade 需要它。
# DEPENDS:=+fit-check-sign —— 该依赖会自动被拉入，不必显式写。
# FIT 块设备释放工具（.itb 升级）
CONFIG_PACKAGE_fitblk=y
# 挂载工具
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_busybox=y
# CGI 上传下载
CONFIG_PACKAGE_cgi-io=y
# 读写 u-boot 环境变量
CONFIG_PACKAGE_uboot-envtools=y

#=========================================================================
