CONFIG_PACKAGE_kmod-phy-airoha-en8811h=y
CONFIG_PACKAGE_airoha-en8811h-firmware=y
# CONFIG_PACKAGE_kmod-phy-maxlinear is not set      # GPY211，本机型不用
# CONFIG_PACKAGE_kmod-phy-realtek is not set        # RTL826x，本机型不用
# CONFIG_PACKAGE_rtl826x-firmware is not set        # RTL826x 固件，本机型不用

#=========================================================================
# 18. 引导与固件 —— TF-A BL2 / BL31（AN7581）
#=========================================================================
CONFIG_PACKAGE_trusted-firmware-a-an7581-bl2=y
CONFIG_PACKAGE_trusted-firmware-a-an7581-bl31=y

