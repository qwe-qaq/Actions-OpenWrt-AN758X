#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#

PROC_STAT="${PROC_STAT:-/proc/stat}"
SAMPLE_DELAY="${SAMPLE_DELAY:-0.2}"
MARK='@CPUUSAGE-SPLIT@'

delay() {
	sleep "$SAMPLE_DELAY" 2>/dev/null || sleep 1
}


legacy_usage() {
	# top 的 CPU 行：空闲列为 $4（$8 是 steal 累计，不是空闲）
	top -n1 2>/dev/null | awk '/^CPU/ { printf("%d%%", 100 - $4); exit }'
}


render() {
	{
		cat "$PROC_STAT"
		echo "$MARK"
		delay
		cat "$PROC_STAT"
	} | awk -v MARK="$MARK" '
	BEGIN { n = 0; part = 1 }


	$1 == MARK { part = 2; next }

	$1 ~ /^cpu[0-9]*$/ {
		t = 0
		for (i = 2; i <= NF && i <= 9; i++)
			t += $i

		if (part == 1) {
			key[n] = $1
			ua[$1] = $2 + $3       # user + nice
			sa[$1] = $4 + $7 + $8  # system + irq + softirq
			ta[$1] = t
			n++
		}
		else {
			ub[$1] = $2 + $3
			sb[$1] = $4 + $7 + $8
			tb[$1] = t
		}
	}

	END {
		total = ""
		cores = ""

		for (i = 0; i < n; i++) {
			k = key[i]

			if (!(k in ta) || !(k in tb))
				continue

			d = tb[k] - ta[k]

			if (d <= 0)
				continue

			u = int((ub[k] - ua[k]) * 100 / d + 0.5)
			s = int((sb[k] - sa[k]) * 100 / d + 0.5)
			if (u < 0) u = 0
			if (s < 0) s = 0

			if (i == 0) {
				total = sprintf("USR: %d%% SYS: %d%%", u, s)
			}
			else {
				tot = int(((ub[k] - ua[k]) + (sb[k] - sa[k])) * 100 / d + 0.5)
				if (tot > 100) tot = 100
				cores = cores sprintf("%s CPU%d %d%%", (i == 1 ? " ·" : ""), i - 1, tot)
			}
		}

		if (total != "")
			print total cores
	}
	'
}

out="$(render 2>/dev/null)"

if [ -n "$out" ]; then
	printf '%s' "$out"
else
	fallback="$(legacy_usage)"
	printf '%s' "${fallback:-?}"
fi
