#!/bin/sh
# 面板 LED 控制后端（LuCI RPC）
# 目标板：AN4475-G2 / HG5382A —— 面板灯全部挂在 PCA9555（i2c 2-0020）上，
# 但本脚本不绑定具体芯片，凡 /sys/class/leds 下的灯都能控制。
#
# 方法：
#   status                         列出所有 LED 及其触发器/亮度
#   set  {led,trigger,brightness,delay_on,delay_off}
#   all  {action: off|on|restore}  批量灭/亮/恢复驱动默认触发器

LED_ROOT=/sys/class/leds

json_str() {
	# 只用于 LED 名与触发器名：去掉反斜杠和双引号，再做转义
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

# 把空格分隔的列表转成 JSON 数组
json_array() {
	printf '%s' "$1" | tr ' ' '\n' | grep -v '^$' | awk '
		BEGIN { ORS = "" }
		{
			gsub(/\\/, "\\\\"); gsub(/"/, "\\\"")
			if (NR > 1) printf ","
			printf "\"%s\"", $0
		}'
}

led_device() {
	# pca9555 上的灯，device 会软链到 .../i2c-2/2-0020/...，据此标注来源
	local path
	path=$(readlink -f "$LED_ROOT/$1/device" 2>/dev/null)
	[ -n "$path" ] || { printf ''; return; }
	case "$path" in
		*i2c-*/*-00[0-9a-f][0-9a-f]*) basename "$(dirname "$path")" ;;
		*/gpiochip*) printf 'gpio' ;;
		*) basename "$path" ;;
	esac
}

list_leds() {
	local dir name raw cur avail bright max dev
	local first=1

	printf '{"leds":['
	for dir in "$LED_ROOT"/*; do
		[ -d "$dir" ] || continue
		name=$(basename "$dir")

		raw=$(cat "$dir/trigger" 2>/dev/null)
		# 当前触发器在方括号里：none default [timer] heartbeat
		cur=$(printf '%s' "$raw" | sed -n 's/.*\[\([^]]*\)\].*/\1/p')
		avail=$(printf '%s' "$raw" | sed 's/\[//g; s/\]//g')

		bright=$(cat "$dir/brightness" 2>/dev/null)
		max=$(cat "$dir/max_brightness" 2>/dev/null)
		dev=$(led_device "$name")

		[ "$first" = 1 ] || printf ','
		first=0
		printf '{"name":"%s","trigger":"%s","triggers":[%s],"brightness":%s,"max":%s,"dev":"%s"}' \
			"$(json_str "$name")" \
			"$(json_str "$cur")" \
			"$(json_array "$avail")" \
			"${bright:-0}" "${max:-1}" \
			"$(json_str "$dev")"
	done
	printf ']}'
}

set_led() {
	local input="$1"
	local led trigger brightness delay_on delay_off
	local path

	led=$(printf '%s' "$input" | jsonfilter -e '@.led' 2>/dev/null)
	[ -n "$led" ] || { echo '{"ok":false,"error":"缺少 led 参数"}'; return; }

	case "$led" in
		*/*|*..*) echo '{"ok":false,"error":"非法 LED 名"}'; return ;;
	esac
	path="$LED_ROOT/$led"
	[ -d "$path" ] || { echo '{"ok":false,"error":"LED 不存在"}'; return; }

	trigger=$(printf '%s' "$input" | jsonfilter -e '@.trigger' 2>/dev/null)
	brightness=$(printf '%s' "$input" | jsonfilter -e '@.brightness' 2>/dev/null)
	delay_on=$(printf '%s' "$input" | jsonfilter -e '@.delay_on' 2>/dev/null)
	delay_off=$(printf '%s' "$input" | jsonfilter -e '@.delay_off' 2>/dev/null)

	# 给了亮度就先摘掉触发器，否则会被触发器立刻覆盖
	if [ -n "$brightness" ]; then
		echo none > "$path/trigger" 2>/dev/null
		if ! echo "$brightness" > "$path/brightness" 2>/dev/null; then
			echo '{"ok":false,"error":"写 brightness 失败"}'
			return
		fi
	fi

	if [ -n "$trigger" ]; then
		case "$trigger" in
			*[!A-Za-z0-9_-]*|'') echo '{"ok":false,"error":"非法触发器名"}'; return ;;
		esac
		# 触发器白名单取自这台设备实际注册的列表，避免瞎写把灯搞成不可控
		if ! sed 's/\[//g; s/\]//g' "$path/trigger" 2>/dev/null | tr ' ' '\n' | grep -qx "$trigger"; then
			echo '{"ok":false,"error":"该触发器不可用"}'
			return
		fi
		echo "$trigger" > "$path/trigger" 2>/dev/null || {
			echo '{"ok":false,"error":"写 trigger 失败"}'
			return
		}
	fi

	# 闪烁周期只能对 timer 生效
	if [ "$trigger" = timer ] || { [ -z "$trigger" ] && [ -n "$delay_on" ]; }; then
		[ -n "$delay_on" ] && [ "$delay_on" -gt 0 ] 2>/dev/null && echo "$delay_on" > "$path/delay_on" 2>/dev/null
		[ -n "$delay_off" ] && [ "$delay_off" -gt 0 ] 2>/dev/null && echo "$delay_off" > "$path/delay_off" 2>/dev/null
	fi

	printf '{"ok":true,"trigger":"%s","brightness":%s}' \
		"$(json_str "$(sed -n 's/.*\[\([^]]*\)\].*/\1/p' "$path/trigger" 2>/dev/null)")" \
		"$(cat "$path/brightness" 2>/dev/null || echo 0)"
}

# 从设备树恢复 gpio-leds 的默认触发器。
# 本板的 PON 灯没有对应的 uci led 段（只有 DTS 的 linux,default-trigger），
# 所以 /etc/init.d/led restart 恢复不了它们，必须单独读一遍 DTS。
# busybox 的 find 走不进 /proc/device-tree，这里用通配符直接展开。
restore_dts_defaults() {
	local f dir label trig
	for f in /proc/device-tree/leds*/*/linux,default-trigger; do
		[ -f "$f" ] || continue
		dir=$(dirname "$f")
		label=$(tr -d '\0' < "$dir/label" 2>/dev/null)
		trig=$(tr -d '\0' < "$f" 2>/dev/null)
		[ -n "$label" ] && [ -n "$trig" ] || continue
		[ -d "$LED_ROOT/$label" ] || continue
		echo "$trig" > "$LED_ROOT/$label/trigger" 2>/dev/null
	done
}

all_leds() {
	local input="$1"
	local action dir max failed=0

	action=$(printf '%s' "$input" | jsonfilter -e '@.action' 2>/dev/null)

	if [ "$action" = restore ]; then
		# 先按 uci 恢复（网口 netdev 之类），再按 DTS 补 PON 灯
		/etc/init.d/led restart >/dev/null 2>&1
		restore_dts_defaults
		printf '{"ok":true,"action":"restore"}'
		return
	fi

	case "$action" in
		on|off) ;;
		*) echo '{"ok":false,"error":"action 只能是 on/off/restore"}'; return ;;
	esac

	for dir in "$LED_ROOT"/*; do
		[ -d "$dir" ] || continue
		max=$(cat "$dir/max_brightness" 2>/dev/null)
		echo none > "$dir/trigger" 2>/dev/null || failed=$((failed + 1))
		if [ "$action" = on ]; then
			echo "${max:-1}" > "$dir/brightness" 2>/dev/null || failed=$((failed + 1))
		else
			echo 0 > "$dir/brightness" 2>/dev/null || failed=$((failed + 1))
		fi
	done

	printf '{"ok":true,"action":"%s","failed":%d}' "$action" "$failed"
}

case "$1" in
	list)
		echo '{"status":{},"set":{"led":"str","trigger":"str","brightness":"int","delay_on":"int","delay_off":"int"},"all":{"action":"str"}}'
		;;
	call)
		read -r input
		case "$2" in
			status) list_leds ;;
			set)    set_led "$input" ;;
			all)    all_leds "$input" ;;
			*)      echo '{"ok":false,"error":"unknown method"}' ;;
		esac
		;;
	*)
		echo '{"ok":false,"error":"usage: luci.ledctl list|call"}'
		;;
esac
